# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Playwright
test-results/
playwright-report/

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Art-generation prompt manifests (--manifest output); scratch, never source.
*.manifest.json
m_*.json

# Python bytecode
__pycache__/
*.pyc

# Local GPU render environment: torch + CUDA wheels and scratch renders,
# ~3 GB. Created by scripts/generate-card-art-diffusers.py runs; never
# belongs in the repo, and is large enough that an accidental 'git add -A'
# is worth guarding against.
.venv-art/

# Serena MCP session cache
.serena/

# Measurement scaffolding written by audit/profiling agents at runtime:
# probe suites, throwaway perf specs, and the alternate vitest config they use
# to run in isolation. Transient by nature — deleted once a run finishes.
#
# Ignored rather than committed for a concrete reason: src/__probe__/*.test.jsx
# matches vitest's own include glob (src/**/*.{test,spec}.{js,jsx}), so a
# committed half-written probe would run as part of the real suite in CI.
# Matched by convention rather than exact name: successive runs invented
# src/__probe__/ and src/__perf_tmp__/, so a name-by-name list is whack-a-mole.
# vitest.config.js itself does not match the pattern below; if you ever add a
# real second vitest config, commit it with `git add -f`.
src/__*__/
vitest.*.config.js
e2e/perf*.spec.js
