# Terrible Teddies Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# FRONTEND (Vite - must be prefixed with VITE_)
# ===========================================

# Supabase Project URL (from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon/Public Key (safe for client-side)
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog Analytics (optional). The ingestion host is fixed in code
# (src/utils/analytics.js) and pinned to the CSP in vercel.json — it is
# deliberately not configurable here, so the two can't drift apart.
VITE_POSTHOG_KEY=

# ===========================================
# SUPABASE EDGE FUNCTIONS (set via Supabase Dashboard or CLI)
# ===========================================
# These are NOT in .env - set them in Supabase Dashboard > Edge Functions > Secrets

# STRIPE_SECRET_KEY=sk_live_xxx (or sk_test_xxx for testing)
# STRIPE_WEBHOOK_SECRET=whsec_xxx (from Stripe Dashboard > Webhooks)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (NEVER expose client-side)
# ALLOWED_ORIGIN=https://your-domain.com (production domain for CORS/redirects)
# DENO_ENV=production (disables localhost origins)
